NODE_ENV=production
REQUIRE_STAFF_MFA=true
HOSTNAME=127.0.0.1
PORT=5173
BETTER_AUTH_URL=https://learning.your-domain.example
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SURAKSHA_DB_PATH=/var/lib/surakshaar/service.sqlite
SURAKSHA_BACKUP_DIR=/var/lib/surakshaar/backups
# Existing account IDs for authorised platform operators, comma separated.
PLATFORM_OPERATOR_IDS=
# Required for issuing credentials; must match lib/trusted-issuer.json and Android trust.
ISSUER_PRIVATE_JWK=
# Optional identity capture, disabled until configured. Base64 of 32 random bytes.
IDENTITY_EVIDENCE_KEY=
# Optional verified email gateway. Recovery remains visibly unavailable without it.
RECOVERY_MAIL_URL=
RECOVERY_MAIL_API_KEY=
